::mlir::ParseResult SwitchOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand selectorRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> selectorOperands(&selectorRawOperand, 1);  ::llvm::SMLoc selectorOperandsLoc;
  (void)selectorOperandsLoc;
  ::mlir::Type selectorRawType{};
  ::llvm::ArrayRef<::mlir::Type> selectorTypes(&selectorRawType, 1);
  ::mlir::Block *defaultTargetSuccessor = nullptr;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> defaultOperandsOperands;
  ::llvm::SMLoc defaultOperandsOperandsLoc;
  (void)defaultOperandsOperandsLoc;
  ::llvm::SmallVector<::mlir::Type, 1> defaultOperandsTypes;
  ::mlir::DenseIntElementsAttr literalsAttr;
  ::llvm::SmallVector<::mlir::Block *, 2> targetsSuccessors;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> targetOperandsOperands;
    llvm::SmallVector<int32_t> targetOperandsOperandGroupSizes;
  ::llvm::SMLoc targetOperandsOperandsLoc;
  (void)targetOperandsOperandsLoc;
  ::llvm::SmallVector<::mlir::Type, 1> targetOperandsTypes;

  selectorOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(selectorRawOperand))
    return ::mlir::failure();
  if (parser.parseColon())
    return ::mlir::failure();

  {
    ::mlir::IntegerType type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    selectorRawType = type;
  }
  if (parser.parseComma())
    return ::mlir::failure();
  if (parser.parseLSquare())
    return ::mlir::failure();
  {
    defaultOperandsOperandsLoc = parser.getCurrentLocation();
    targetOperandsOperandsLoc = parser.getCurrentLocation();
    ::llvm::SmallVector<::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand>> targetOperandsOperandGroups;
    ::llvm::SmallVector<llvm::SmallVector<::mlir::Type>> targetOperandsTypeGroups;
    auto odsResult = parseSwitchOpCases(parser, selectorRawType, defaultTargetSuccessor, defaultOperandsOperands, defaultOperandsTypes, literalsAttr, targetsSuccessors, targetOperandsOperandGroups, targetOperandsTypeGroups);
    if (odsResult) return ::mlir::failure();
    if (literalsAttr)
      result.getOrAddProperties<SwitchOp::Properties>().literals = literalsAttr;
    for (const auto &subRange : targetOperandsOperandGroups) {
      targetOperandsOperands.append(subRange.begin(), subRange.end());
      targetOperandsOperandGroupSizes.push_back(subRange.size());
    }
    for (const auto &subRange : targetOperandsTypeGroups)
      targetOperandsTypes.append(subRange.begin(), subRange.end());
  }
  if (parser.parseRSquare())
    return ::mlir::failure();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  result.addSuccessors(defaultTargetSuccessor);
  result.addSuccessors(targetsSuccessors);
::llvm::copy(::llvm::ArrayRef<int32_t>({1, static_cast<int32_t>(defaultOperandsOperands.size()), static_cast<int32_t>(targetOperandsOperands.size())}), result.getOrAddProperties<SwitchOp::Properties>().operandSegmentSizes.begin());
  result.getOrAddProperties<SwitchOp::Properties>().case_operand_segments = parser.getBuilder().getDenseI32ArrayAttr(targetOperandsOperandGroupSizes);
  if (parser.resolveOperands(selectorOperands, selectorTypes, selectorOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(defaultOperandsOperands, defaultOperandsTypes, defaultOperandsOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(targetOperandsOperands, targetOperandsTypes, targetOperandsOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void SwitchOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter << getSelector();
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
  {
    auto type = getSelector().getType();
    if (auto validType = ::llvm::dyn_cast<::mlir::IntegerType>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  _odsPrinter << ",";
  _odsPrinter << ' ' << "[";
  _odsPrinter.printNewline();
  printSwitchOpCases(_odsPrinter, *this, getSelector().getType(), getDefaultTarget(), getDefaultOperands(), getDefaultOperands().getTypes(), getLiteralsAttr(), getTargets(), getTargetOperands(), getTargetOperands().getTypes());
  _odsPrinter << "]";
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("operandSegmentSizes");
  elidedAttrs.push_back("case_operand_segments");
  elidedAttrs.push_back("literals");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}

